# RoboBee Health Guardian (AstroHealth Guardian) — Environment Configuration
# Copy this file to `.env` and set your Gemini API key before starting the server.

GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional Gemini Model Overrides
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_LIVE_MODEL=gemini-3.8-live

# Optional HuskyLens 2 Edge AI Camera Configuration
HUSKYLENS_ENABLED=false
HUSKYLENS_SSE_URL=
